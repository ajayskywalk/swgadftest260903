{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "swgdftest20260903"
		},
		"AzureBlobStorageLinkedServer260903_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorageLinkedServer260903'",
			"defaultValue": "DefaultEndpointsProtocol=https;AccountName=@{linkedService().accountName};"
		},
		"kevalut260903linkedservice_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://keyvalut260903.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "swgdftest20260903_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorageLinkedServer260903_connectionString": {
						"value": "[parameters('AzureBlobStorageLinkedServer260903_connectionString')]"
					},
					"kevalut260903linkedservice_properties_typeProperties_baseUrl": {
						"value": "[parameters('kevalut260903linkedservice_properties_typeProperties_baseUrl')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}