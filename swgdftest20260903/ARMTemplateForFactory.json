	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/CopyFilePipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "CopyFile",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "WaitActivity",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "BinarySource",
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": true
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							},
							"sink": {
								"type": "BinarySink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "TestFileDataSet",
								"type": "DatasetReference",
								"parameters": {
									"accountName": {
										"value": "@pipeline().parameters.SourceAccountname",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "TestFileOutput260903",
								"type": "DatasetReference",
								"parameters": {
									"accountName": {
										"value": "@pipeline().parameters.DestinationAccountName",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "WaitActivity",
						"type": "Wait",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"waitTimeInSeconds": {
								"value": "@pipeline().parameters.WaitSeconds",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Notify_Success",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "CopyFile",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": true,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {
								"Content-Type": "application/json"
							},
							"url": "https://prod-21.centralindia.logic.azure.com:443/workflows/0ee5a1f34b334afd825af545cd8e444c/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01",
							"body": {
								"value": "{\"recipient\":\"@{pipeline().parameters.NotifyEmailAddress}\",\"emailsubject\":\"@{pipeline().Pipeline} completed successfully | Run ID: @{pipeline().RunId}\", \"emailbody\":\"@{pipeline().Pipeline} completed successfully | Run ID: @{pipeline().RunId}\" }",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Notify_Failure",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "CopyFile",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": true,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {
								"Content-Type": "application/json"
							},
							"url": "https://prod-21.centralindia.logic.azure.com:443/workflows/0ee5a1f34b334afd825af545cd8e444c/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01",
							"body": {
								"value": "{\"recipient\":\"@{pipeline().parameters.NotifyEmailAddress}\",\"emailsubject\":\"@{pipeline().Pipeline} Failed | Run ID: @{pipeline().RunId}\", \"emailbody\":\"@{pipeline().Pipeline} Failed at @{utcNow()} <br> Run ID: @{pipeline().RunId} <br> Errormessage : @{activity('CopyFile').error.message} <br> Time : @{utcNow()}\" }",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"DestinationAccountName": {
						"type": "string",
						"defaultValue": "swgsadftest20260903"
					},
					"WaitSeconds": {
						"type": "int",
						"defaultValue": 15
					},
					"SourceAccountname": {
						"type": "String",
						"defaultValue": "swgsadftest20260903"
					},
					"NotifyEmailAddress": {
						"type": "string",
						"defaultValue": "agopalakrishnan@homesteaderslife.com"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-09-04T12:57:37Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/TestFileDataSet')]",
				"[concat(variables('factoryId'), '/datasets/TestFileOutput260903')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/TestFileDataSet')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureBlobStorageLinkedServer260903",
					"type": "LinkedServiceReference",
					"parameters": {
						"accountName": "@dataset().accountName",
						"secretName": "swgsadftestKey20260903"
					}
				},
				"parameters": {
					"accountName": {
						"type": "string",
						"defaultValue": "swgsadftest20260903"
					}
				},
				"annotations": [],
				"type": "Binary",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "TestFile.txt",
						"folderPath": "inputdirectory",
						"container": "inputcontainer"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureBlobStorageLinkedServer260903')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/TestFileOutput260903')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureBlobStorageLinkedServer260903",
					"type": "LinkedServiceReference",
					"parameters": {
						"accountName": "@dataset().accountName",
						"secretName": "swgsadftestKey20260903"
					}
				},
				"parameters": {
					"accountName": {
						"type": "string",
						"defaultValue": "swgsadftest20260903"
					}
				},
				"annotations": [],
				"type": "Binary",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "FileName11",
						"folderPath": "outputdirectory",
						"container": "outputcontainer"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureBlobStorageLinkedServer260903')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureBlobStorageLinkedServer260903')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"parameters": {
					"accountName": {
						"type": "[parameters('AzureBlobStorageLinkedServer260903_properties_parameters_accountName_type')]",
						"defaultValue": "[parameters('AzureBlobStorageLinkedServer260903_properties_parameters_accountName_defaultValue')]"
					},
					"secretName": {
						"type": "[parameters('AzureBlobStorageLinkedServer260903_properties_parameters_secretName_type')]",
						"defaultValue": "[parameters('AzureBlobStorageLinkedServer260903_properties_parameters_secretName_defaultValue')]"
					}
				},
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('AzureBlobStorageLinkedServer260903_connectionString')]",
					"accountKey": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "kevalut260903linkedservice",
							"type": "LinkedServiceReference"
						},
						"secretName": {
							"value": "@linkedService().secretName",
							"type": "Expression"
						}
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/kevalut260903linkedservice')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/kevalut260903linkedservice')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('kevalut260903linkedservice_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/trigger1')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"runtimeState": "Stopped",
				"pipelines": [],
				"type": "ScheduleTrigger",
				"typeProperties": {
					"recurrence": {
						"frequency": "Day",
						"interval": 1,
						"startTime": "2026-09-07T12:00:00",
						"timeZone": "India Standard Time"
					}
				}
			},
			"dependsOn": []
		}
	]
