{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "swgdftest20260903"
		},
		"AzureBlobStorageLinkedServer260903_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorageLinkedServer260903'",
			"defaultValue": "DefaultEndpointsProtocol=https;AccountName=@{linkedService().accountName};"
		},
		"AzureBlobStorageLinkedServer260903_properties_parameters_accountName_type": {
			"type": "string",
			"defaultValue": "string"
		},
		"AzureBlobStorageLinkedServer260903_properties_parameters_accountName_defaultValue": {
			"type": "string",
			"defaultValue": "swgsadftest20260903"
		},
		"AzureBlobStorageLinkedServer260903_properties_parameters_secretName_type": {
			"type": "string",
			"defaultValue": "string"
		},
		"AzureBlobStorageLinkedServer260903_properties_parameters_secretName_defaultValue": {
			"type": "string",
			"defaultValue": "swgsadftestKey20260903"
		},
		"kevalut260903linkedservice_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://keyvalut260903.vault.azure.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
