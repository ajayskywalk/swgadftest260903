				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-21.centralindia.logic.azure.com:443/workflows/0ee5a1f34b334afd825af545cd8e444c/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=DKQAkoVIifbgWYjYLr7EfuN9XICLr_Ds5zJovBlgN74",
					"body": {
						"pipelineName": "@{pipeline().Pipeline}",
						"pipelineRunId": "@{pipeline().RunId}",
						"status": "Failed",
						"timestamp": "@{utcNow()}",
						"errorMessage": "",
						"recipient": "@{pipeline().parameters.ToEmailAddress}"
					}
				}
			},
			{
				"name": "Notify_Failure",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "CopyFile",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-21.centralindia.logic.azure.com:443/workflows/0ee5a1f34b334afd825af545cd8e444c/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=DKQAkoVIifbgWYjYLr7EfuN9XICLr_Ds5zJovBlgN74",
					"body": {
						"pipelineName": "@{pipeline().Pipeline}",
