					"waitTimeInSeconds": {
						"value": "@pipeline().parameters.WaitSeconds",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Notify_Success",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "CopyFile",
						"dependencyConditions": [
							"Succeeded"
						]
